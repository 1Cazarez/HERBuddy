# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000

# Where the static frontend is served from, for CORS.
CLIENT_ORIGIN=http://localhost:8934

# TigerData / Postgres connection string.
# TigerData (https://console.cloud.tigerdata.com) gives you this on your
# service's "Connection info" page — it's a standard Postgres URI.
DATABASE_URL=postgres://tsdbadmin:password@your-service.tigerdata.com:5432/tsdb?sslmode=require

# Auth0 application settings (Applications > APIs in the Auth0 dashboard).
# AUTH0_DOMAIN is your tenant domain, e.g. dev-abc123.us.auth0.com
# AUTH0_AUDIENCE is the Identifier of the Auth0 API you create for this backend.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://herbuddy-api

# Google Maps JavaScript API key (Google Cloud Console > APIs & Services >
# Credentials). Restrict it there by HTTP referrer to your deployed
# frontend domain(s) — the key is inherently visible in the browser once
# loaded, so that referrer restriction is the real protection, not keeping
# it out of source control.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ElevenLabs Conversational AI agent IDs for the "Talk to Walking Companion"
# voice-chat feature (ElevenLabs dashboard > Conversational AI > Agents).
# Not secrets by themselves (an agent ID alone doesn't grant API access),
# but keeping them server-side means they can be rotated/swapped without a
# frontend code change, same as the Maps key above.
ELEVENLABS_AGENT_ID_FRIEND=your-friend-persona-agent-id
ELEVENLABS_AGENT_ID_GRANDMA=your-grandma-persona-agent-id
